# Example /etc/yt-deferred-uploader/env for the systemd unit.
# Owner root, mode 0600. Replace every value; never commit the real file.

YOUTUBE_CLIENT_ID=replace-me.apps.googleusercontent.com
YOUTUBE_CLIENT_SECRET=replace-me
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Base64-encoded 32-byte key, e.g. from: openssl rand -base64 32
# Keep it: without the same key, stored OAuth tokens cannot be decrypted.
ENCRYPTION_KEY=replace-me
# The public https:// URL served by your reverse proxy, also registered in the
# Google Cloud Console OAuth client.
APP_YOUTUBE_REDIRECT_URI=https://example.invalid/settings/oauth/callback
